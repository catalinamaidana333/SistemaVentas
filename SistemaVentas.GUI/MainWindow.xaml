<Window x:Class="SistemaVentas.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaVentas.GUI"
        mc:Ignorable="d"
        Title="Sistema de Ventas" Height="550" Width="1050"
        MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú Lateral (columna 0) -->
        <Border Grid.Column="0" Background="{StaticResource BgHeader}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MINIMARKET"
                           Foreground="{StaticResource OroTexto}"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Margin="15,10">
                    <Button x:Name="btnVentas" Content="Punto de Venta"
                            Style="{StaticResource BotonMenuLateral}"
                            Click="btnVentas_Click"/>
                    <Button x:Name="btnProductos" Content="Productos"
                            Style="{StaticResource BotonMenuLateral}"
                            Click="btnProductos_Click"/>
                    <Button x:Name="btnUsuarios" Content="Usuarios"
                            Style="{StaticResource BotonMenuLateral}"
                            Click="btnUsuarios_Click"/>
                    <Button x:Name="btnCompra" Content="Compras"
                            Style="{StaticResource BotonMenuLateral}"
                            Click="btnCompra_Click"/>
                    
                    <!-- Botón Principal de Reportes -->
                    <Button x:Name="btnReportes" Content="Reportes" 
                            Style="{StaticResource BotonMenuLateral}" 
                            Click="btnReportes_Click"/>

                    <!-- Subbotones Gerente -->
                    <Button x:Name="btnSubRentabilidad" Content="  • Rentabilidad" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubRentabilidad_Click"/>
                    <Button x:Name="btnSubAuditoria" Content="  • Auditoría" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubAuditoria_Click"/>
                    <Button x:Name="btnSubRendimiento" Content="  • Rendimiento" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubRendimiento_Click"/>

                    <!-- Subbotones Supervisor -->
                    <Button x:Name="btnSubStockCritico" Content="  • Stock Crítico" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubStockCritico_Click"/>
                    <Button x:Name="btnSubVentasCanceladas" Content="  • Ventas Canceladas" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubVentasCanceladas_Click"/>
                    <Button x:Name="btnSubVentasVendedor" Content="  • Ventas por Vendedor" Style="{StaticResource BotonMenuLateral}" Visibility="Collapsed" Click="btnSubVentasVendedor_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área de Contenido Dinámico (columna 1, único elemento) -->
        <ContentControl x:Name="ContenedorPrincipal" Grid.Column="1"/>
    </Grid>
</Window>