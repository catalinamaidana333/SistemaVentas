<UserControl x:Class="SistemaVentas.GUI.Compra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgFondoPrincipal}">

    <!-- Grilla Principal: Fila para Navbar y Fila para Contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar Superior -->
        <Grid Grid.Row="0" Background="{StaticResource BgHeader}">
            <TextBlock Text="COMPRAS E INGRESOS" Foreground="{StaticResource TextoClaro}" 
                       FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="txtUsuarioActual"
                           Text="⚙️ Usuario"
                           Foreground="{StaticResource TextoClaro}" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Contenedor Principal Dividido (Izquierda 65% / Derecha 35%) -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMNA IZQUIERDA (Proveedores y Productos)-->
            <!-- ========================================== -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="PURCHASE ORDER" Style="{StaticResource TituloPrincipal}" Margin="0,0,0,20"/>

                <!-- 1. SECCIÓN PROVEEDOR Y FACTURA -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cmbProveedor" Grid.Column="0" Height="40" IsEditable="True"
                              IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False"
                              TextSearch.TextPath="RazonSocial" DisplayMemberPath="RazonSocial"
                              Margin="0,0,10,0" ToolTip="Buscar o ingresar proveedor..."/>

                    <Button x:Name="btnNuevoProveedor" Grid.Column="1" Content="+" Style="{StaticResource BotonPrimario}"
                            Width="40" Height="40" Margin="0,0,10,0" ToolTip="Nuevo Proveedor"
                            Click="btnNuevoProveedor_Click"/>

                    <TextBox x:Name="txtNumeroFactura" Grid.Column="2" Style="{StaticResource InputTexto}"
                             Height="40" ToolTip="Número de factura del proveedor"/>
                </Grid>

                <!-- 2. PRODUCTO A INGRESAR -->
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cmbProductos" Grid.Column="0" Height="40" IsEditable="True"
                              IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False"
                              TextSearch.TextPath="Nombre" DisplayMemberPath="Nombre"
                              Margin="0,0,10,0" ToolTip="Buscar un producto del catálogo"
                              SelectionChanged="cmbProductos_SelectionChanged"/>

                    <TextBox x:Name="txtCantidad" Grid.Column="1" Style="{StaticResource InputTexto}"
                             Height="40" Text="1" Margin="0,0,10,0" ToolTip="Cantidad"/>

                    <TextBox x:Name="txtCostoUnitario" Grid.Column="2" Style="{StaticResource InputTexto}"
                             Height="40" Margin="0,0,10,0" ToolTip="Costo unitario"/>

                    <Button x:Name="btnAgregarProducto" Grid.Column="3" Content="+ AGREGAR"
                            Style="{StaticResource BotonPrimario}" Width="110" Height="40"
                            Click="btnAgregarProducto_Click"/>
                </Grid>

                <!-- 3. TABLA DE COMPRAS (DataGrid) -->
                <DataGrid Grid.Row="3" x:Name="dgCompras" HeadersVisibility="Column"
                          PreviewKeyDown="dgCompras_PreviewKeyDown"
                          CellEditEnding="dgCompras_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="50" Binding="{Binding IdProducto}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ITEM" Width="*" Binding="{Binding NombreProducto}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="STOCK" Width="70" Binding="{Binding StockActual}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="QTY IN" Width="80" Binding="{Binding Cantidad}"/>
                        <DataGridTextColumn Header="UNIT COST" Width="100" Binding="{Binding CostoUnitario}"/>
                        <DataGridTemplateColumn Header="+ / −" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content=" - " Width="25" Click="btnRestar_Click" Tag="{Binding}"/>
                                        <Button Content=" + " Width="25" Click="btnSumar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SUBTOTAL" Width="110" Binding="{Binding Subtotal, StringFormat=N2}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 4. PANEL INFERIOR IZQUIERDO -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnEliminarLinea" Grid.Column="0" Content="ELIMINAR"
                            Style="{StaticResource BotonPrimario}" Width="100" Height="40"
                            Margin="0,0,10,0" Click="btnEliminarLinea_Click"/>
                    <Button x:Name="btnSubir" Grid.Column="1" Content="▲" Style="{StaticResource BotonPrimario}"
                            Width="50" Height="40" Margin="0,0,5,0" Click="btnSubir_Click"/>
                    <Button x:Name="btnBajar" Grid.Column="2" Content="▼" Style="{StaticResource BotonPrimario}"
                            Width="50" Height="40" Margin="0,0,15,0" Click="btnBajar_Click"/>
                    <TextBox x:Name="txtObservaciones" Grid.Column="3" Style="{StaticResource InputTexto}"
                             Height="40" ToolTip="Observaciones de la compra"/>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- COLUMNA DERECHA (Panel de Pago / Egreso)   -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource BgPaneles}" CornerRadius="8" Padding="20">
                <StackPanel>

                    <!-- Tarjeta del Total -->
                    <Border BorderBrush="{StaticResource DoradoSaffron}" BorderThickness="3" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="TOTAL" Foreground="{StaticResource TextoClaro}" FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTotal" Text="$ 0.00" Foreground="{StaticResource OroTexto}"
                                       FontSize="36" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="txtCantidadItems" Text="0 items" Foreground="{StaticResource TextoSecundario}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón Principal de Compra -->
                    <Button x:Name="btnProcesarCompra" Content="PROCESAR" Style="{StaticResource BotonPrimario}"
                            Height="50" Margin="0,0,0,20" FontSize="18" Click="btnProcesarCompra_Click"/>

                    <!-- Selección de Método de Pago -->
                    <TextBlock Text="METODO DE PAGO" Foreground="{StaticResource TextoClaro}" FontSize="14"
                               FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Margin="0,0,0,15">
                        <RadioButton x:Name="rbMercadoPago" Content="📱 Mercado Pago" Foreground="{StaticResource TextoClaro}"
                                     Margin="0,5" FontSize="14" IsChecked="True" Checked="rbMercadoPago_Checked"/>
                        <RadioButton x:Name="rbEfectivo" Content="💵 Efectivo" Foreground="{StaticResource TextoClaro}"
                                     Margin="0,5" FontSize="14" Checked="rbEfectivo_Checked"/>
                    </StackPanel>

                    <!-- PANEL CONDICIONAL: Origen del Efectivo -->
                    <Border x:Name="panelOrigenEfectivo" Background="{StaticResource BgInputs}" CornerRadius="5"
                            Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Origen del efectivo:" Foreground="{StaticResource TextoOscuro}"
                                       FontSize="12" Margin="0,0,0,10"/>
                            <RadioButton x:Name="rbCaja" Content="Caja / Mostrador" Foreground="{StaticResource TextoOscuro}"
                                         Margin="0,5" IsChecked="True"/>
                            <RadioButton x:Name="rbExterna" Content="Fondos externos" Foreground="{StaticResource TextoOscuro}"
                                         Margin="0,5"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
