<Window x:Class="SistemaVentas.GUI.Dialogs.CobroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro en Efectivo" Height="330" Width="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">

        <TextBlock Text="Total a Pagar:" FontSize="14" Foreground="Gray"/>
        <TextBlock x:Name="txtTotal" Text="$ 0.00" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Abona con (Ingrese monto):" FontSize="14"/>
        <!-- El evento TextChanged es la clave para el cálculo en vivo -->
        <TextBox x:Name="txtMontoAbonado" FontSize="22" FontWeight="Bold" Margin="0,5,0,20" 
                 TextAlignment="Right" TextChanged="txtMontoAbonado_TextChanged"/>

        <TextBlock Text="Vuelto a entregar:" FontSize="14" Foreground="Gray"/>
        <TextBlock x:Name="txtVuelto" Text="$ 0.00" FontSize="28" FontWeight="Bold" Foreground="ForestGreen" Margin="0,0,0,20"/>

        <Button Content="CONFIRMAR PAGO" Click="btnConfirmar_Click" Height="40" FontSize="14" FontWeight="Bold" Background="#0A1931" Foreground="White"/>

    </StackPanel>
</Window>