<Window x:Class="SistemaVentas.GUI.Dialogs.DialogIngresoEgreso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de caja" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPaneles}"
        Foreground="{DynamicResource TextoClaro}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

        <TextBlock Grid.Row="1" Text="Caja:" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbCaja" Grid.Row="2" Height="38" Margin="0,0,0,12"
                  DisplayMemberPath="Descripcion"/>

        <TextBlock Grid.Row="3" Text="Monto:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtMonto" Grid.Row="4" Height="40" Margin="0,0,0,12"
                 Style="{StaticResource InputTexto}" VerticalAlignment="Top"
                 PreviewTextInput="txtMonto_PreviewTextInput"/>

        <TextBlock Grid.Row="5" Text="Motivo (obligatorio):" Margin="0,0,0,5"/>
        <TextBox x:Name="txtMotivo" Grid.Row="6" Style="{StaticResource InputTexto}"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Width="100" Height="40"
                    Click="btnGuardar_Click" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Style="{StaticResource BotonPrimario}" Width="100" Height="40"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
