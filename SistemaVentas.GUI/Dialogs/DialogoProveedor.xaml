<Window x:Class="SistemaVentas.GUI.Dialogs.DialogoProveedor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Proveedor" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPaneles}"
        Foreground="{DynamicResource TextoClaro}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Alta rápida de proveedor" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

        <TextBlock Grid.Row="1" Text="Razón Social:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtRazonSocial" Grid.Row="2" Height="38" Margin="0,0,0,10" Style="{StaticResource InputTexto}"/>

        <TextBlock Grid.Row="3" Text="CUIT:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtCuit" Grid.Row="4" Height="38" Margin="0,0,0,10" Style="{StaticResource InputTexto}"
                 ToolTip="Ingrese CUIT de 11 dígitos (con o sin guiones). Ejemplo: 30-71234567-1"/>

        <TextBlock Grid.Row="5" Text="Teléfono:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtTelefono" Grid.Row="6" Height="38" Margin="0,0,0,10" Style="{StaticResource InputTexto}"/>

        <TextBlock Grid.Row="7" Text="Contacto:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtContacto" Grid.Row="8" Height="38" Margin="0,0,0,10" Style="{StaticResource InputTexto}"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Width="100" Height="40"
                    Click="btnGuardar_Click" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Style="{StaticResource BotonPrimario}" Width="100" Height="40"
                    Click="btnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
