<Window x:Class="SistemaVentas.GUI.DialogoCredencial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validación de Credenciales" Height="300" Width="380" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#000035" Foreground="White">

    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">

            <!-- TÍTULO -->
            <TextBlock Text="Autorización Requerida" 
                       FontSize="18" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,15" 
                       HorizontalAlignment="Center"/>

            <!-- USUARIO (Renglón blanco) -->
            <TextBlock Text="Usuario (Correo):" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="32" Margin="0,0,0,12" 
                     Background="White" 
                     Foreground="Black" 
                     BorderBrush="#021056"
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>

            <!-- CONTRASEÑA (Renglón blanco) -->
            <TextBlock Text="Contraseña:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="32" Margin="0,0,0,20" 
                         Background="White" 
                         Foreground="Black" 
                         BorderBrush="#021056"
                         VerticalContentAlignment="Center"
                         Padding="5,0"/>

            <!-- BOTONES DE ACCIÓN -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Botón Aceptar (Azul principal) -->
                <Button x:Name="btnAceptar" Content="Aceptar" Width="95" Height="34" 
                        Background="#021056" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="btnAceptar_Click" Margin="0,0,10,0"/>

                <!-- Botón Cancelar (Pintado completamente de Amarillo warning) -->
                <Button Content="Cancelar" Width="95" Height="34" 
                        Background="#F2C832" Foreground="#000035" FontWeight="Bold"
                        BorderBrush="#F2C832" 
                        Cursor="Hand" Click="btnCancelar_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>