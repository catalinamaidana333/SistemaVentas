<UserControl x:Class="SistemaVentas.GUI.UsuarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BgFondoPrincipal}">

    <!-- Contenedor principal con margen general -->
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!-- Fila 0: Para el Header (Título y Botón) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Para la Grilla (Ocupa el resto de la pantalla) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: Título a la izquierda, Botón a la derecha -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtTituloUsuarios" 
                       Text="Gestión de Usuarios" 
                       Style="{StaticResource TituloPrincipal}" 
                       Grid.Column="0" 
                       VerticalAlignment="Center"/>

            <Button x:Name="btnCrearUsuario" 
                    Content="Crear Usuario" 
                    Click="btnCrearUsuario_Click"
                    Style="{StaticResource BotonPrimario}" 
                    Grid.Column="1" 
                    Width="160" 
                    Height="40"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- DATAGRID: Tabla de usuarios heredando estilo base -->
        <DataGrid x:Name="dgListaUsuarios" 
                  Grid.Row="1" 
                  Margin="0,10,0,0">
            <!-- Definición visual de columnas (Sin lógica aún) -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="Auto"/>
                <DataGridTextColumn Header="Nombre" Width="*"/>
                <DataGridTextColumn Header="Correo Electrónico" Width="*"/>
                <DataGridTextColumn Header="Rol" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- ESTE ES EL MODAL SUPERPUESTO (Inicialmente oculto) -->
        <Grid x:Name="ModalCrearUsuario" Visibility="Collapsed" Background="#80000000">
            <!-- Contenedor blanco del formulario -->
            <Border Width="350" Height="420" Background="White" CornerRadius="10" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <StackPanel>
                    <TextBlock Text="NUEVO USUARIO" FontWeight="Bold" FontSize="18" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Nombre Completo" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtNombre" Height="30" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Email" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCorreo" Height="30" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Rol Asignado" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbRol" Height="30" Margin="0,0,0,25" Padding="5">
                        <!-- Ajusta el Tag al ID real que tengan en tu base de datos -->
                        <ComboBoxItem Content="Vendedor" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="Supervisor" Tag="3"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Guardar" Click="btnGuardarUsuario_Click" 
                            Width="120" Height="35" Margin="0,0,15,0" 
                            Background="#28a745" Foreground="White"/>
                        <Button Content="Cancelar" Click="btnCerrarModal_Click" 
                            Width="120" Height="35" 
                            Background="#dc3545" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- </Grid> (Aquí termina tu Grid principal) -->
    </Grid>
    
</UserControl>