<UserControl x:Class="SistemaVentas.GUI.Ventas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgFondoPrincipal}">

    <!-- Grilla Principal: Fila para Navbar y Fila para Contenido -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar Superior (Simulada) -->
        <Grid Grid.Row="0" Background="{StaticResource BgHeader}">
            <TextBlock Text="POS" Foreground="{StaticResource TextoClaro}" 
                       FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="btnAbrirCerrarCaja" Content="📂 ABRIR CAJA" 
                        Style="{StaticResource BotonPrimario}" Height="40" Width="150" 
                        Click="btnAbrirCerrarCaja_Click" Margin="0,0,15,0"/>
                <TextBlock Text="⚙️ USERNAME" Foreground="{StaticResource TextoClaro}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenedor Principal Dividido (Izquierda 65% / Derecha 35%) -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMNA IZQUIERDA (Lista de Productos)     -->
            <!-- ========================================== -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="POINT OF SALE" Style="{StaticResource TituloPrincipal}" Margin="0,0,0,20"/>

                <!-- Búsqueda y selección de productos del catálogo -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cmbProductos" Grid.Column="0" Height="40" IsEditable="True"
                              IsTextSearchEnabled="True" DisplayMemberPath="Nombre"
                              Margin="0,0,10,0"
                              ToolTip="Buscar un producto del catálogo"/>

                    <Button Grid.Column="1" x:Name="btnAgregarProducto" Content="+ AGREGAR" 
            Style="{StaticResource BotonPrimario}" Width="100" Height="40" 
            Click="btnAgregarProducto_Click"/>
                </Grid>

                <!-- Tabla de Ventas (DataGrid) -->
                <!-- Tabla de Ventas (DataGrid) -->
                <DataGrid Grid.Row="2" x:Name="dgVentas" AutoGenerateColumns="False" PreviewKeyDown="dgVentas_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="50" Binding="{Binding IdProducto}"/>
                        <DataGridTextColumn Header="ITEM" Width="*" Binding="{Binding NombreProducto}"/>
                        <DataGridTextColumn Header="QUANTITY" Width="100" Binding="{Binding Cantidad}"/>
                        <DataGridTextColumn Header="PRICE" Width="80" Binding="{Binding PrecioUnitario}"/>
                        <DataGridTemplateColumn Header="Cant.">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Botón Menos -->
                                        <Button Content=" - " Width="25" Click="btnRestar_Click" Tag="{Binding}"/>

                                        <!-- Texto de la Cantidad -->
                                        <TextBlock Text="{Binding Cantidad}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Botón Más -->
                                        <Button Content=" + " Width="25" Click="btnSumar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="AMOUNT" Width="120" Binding="{Binding Subtotal}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Panel Inferior Izquierdo (Acciones de fila) -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="DELETE" Style="{StaticResource BotonPrimario}" Width="100" Height="40" Margin="0,0,10,0" Click="Button_Click"/>
                    <Button Grid.Column="1" Content="▲" Style="{StaticResource BotonPrimario}" Width="50" Height="40" Margin="0,0,5,0"/>
                    <Button Grid.Column="2" Content="▼" Style="{StaticResource BotonPrimario}" Width="50" Height="40" Margin="0,0,15,0"/>
                    <TextBox Grid.Column="3" Style="{StaticResource InputTexto}" Height="40" Text="Notes..."/>
                </Grid>

                <!-- Panel de Ingreso y Egreso (Efectivo) -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="💰 Ingreso (Efectivo)" Style="{StaticResource BotonPrimario}" Height="40"/>
                    <Button Grid.Column="2" Content="💸 Egreso (Efectivo)" Style="{StaticResource BotonPrimario}" Height="40"/>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- COLUMNA DERECHA (Panel de Cobro)           -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource BgPaneles}" CornerRadius="8" Padding="20">
                <StackPanel>

                    <!-- Tarjeta del Total -->
                    <!-- Tarjeta del Total -->
                    <Border BorderBrush="{StaticResource DoradoSaffron}" BorderThickness="3" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="TOTAL" Foreground="{StaticResource TextoClaro}" FontSize="14" FontWeight="Bold"/>
                            <!-- Les agregamos x:Name para modificarlos desde el code-behind -->
                            <TextBlock x:Name="txtTotal" Text="$ 0.00" Foreground="{StaticResource OroTexto}" FontSize="36" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="txtCantidadItems" Text="0 items" Foreground="#A0A0A0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Botón Principal de Venta -->
                    <Button Content="PROCESS SALE" Style="{StaticResource BotonPrimario}" Height="50" Margin="0,0,0,15" FontSize="18" Click="Button_Click_2"/>

                    <!-- Selector de Método de Pago -->
                    <ComboBox x:Name="_cmbMetodoPago" Height="40" Margin="0,0,0,20" SelectedIndex="0" 
                              FontFamily="{StaticResource FuentePrimaria}" FontSize="14">
                        <ComboBoxItem Content="💳 Efectivo" Tag="Efectivo"/>
                        <ComboBoxItem Content="💳 Mercado Pago" Tag="Mercado Pago"/>
                    </ComboBox>

                    <!-- Grilla de Botones Secundarios (2x2) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Fila 1 -->
                        <Button Grid.Row="0" Grid.Column="0" Content="AGREGAR SELECCIONADO" Style="{StaticResource BotonPrimario}" Click="btnAgregarProducto_Click"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="LIMPIAR CARRITO" Style="{StaticResource BotonPrimario}" Click="Button_Click_1"/>

                        <!-- Fila 2 -->
                        <Button Grid.Row="2" Grid.Column="0" Content="📄 RECEIPT" Style="{StaticResource BotonPrimario}"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="↪ CANCEL" Style="{StaticResource BotonPrimario}" Click="Button_Click_1"/>
                    </Grid>

                    <!-- Resumen de Impuestos -->
                    <Separator Background="{StaticResource BgInputs}" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Discount:" Foreground="{StaticResource TextoClaro}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="0" Text="MK 0.00" Foreground="{StaticResource TextoClaro}" HorizontalAlignment="Right" FontWeight="Bold"/>

                        <TextBlock Grid.Row="2" Text="Tax (0%):" Foreground="{StaticResource TextoClaro}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="2" Text="MK 0.00" Foreground="{StaticResource TextoClaro}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>