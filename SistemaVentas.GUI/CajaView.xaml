<UserControl x:Class="SistemaVentas.GUI.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="20">
        <!-- ÁREA PRINCIPAL -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Gestión de Cajas" Foreground="White" 
                           FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>

                <Button x:Name="btnMostrarFormulario" Grid.Column="1" Content="+ Agregar Caja" 
                        Padding="18,10" Background="#F59E0B" Foreground="#0F172A" 
                        FontWeight="Bold" FontSize="14" Cursor="Hand"
                        Click="btnMostrarFormulario_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- TABLA DE CAJAS CORREGIDA -->
            <DataGrid x:Name="dgvCajas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1E293B" RowBackground="#1E293B" Foreground="White" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      BorderThickness="0" FontSize="15" RowHeight="42">

                <!-- FORZAR TEXTO BLANCO EN TODAS LAS CELDAS DE LA TABLA -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="10,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <!-- ENCABEZADOS EN AMARILLO/DORADO Y NEGRITA -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0A0F1D"/>
                        <Setter Property="Foreground" Value="#F59E0B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdCaja}" Width="80"/>

                    <!-- DESCRIPCIÓN CON ANCHO COMPLETO (*) Y AJUSTE DE TEXTO -->
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ESTADO FORMATO TEXTO (Activa / Inactiva) -->
                    <DataGridTemplateColumn Header="Estado" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Inactiva"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <!-- Rojo -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activa}" Value="True">
                                                    <Setter Property="Text" Value="Activa"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <!-- Verde -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- PANEL DESPLEGABLE LATERAL -->
        <Border x:Name="panelFormulario" HorizontalAlignment="Right" Width="380" Background="#1E293B" 
                CornerRadius="10" Padding="25" Visibility="Collapsed" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Nueva Caja" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="White" 
                            FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCerrarFormulario_Click"/>
                </Grid>

                <TextBlock Text="Descripción (N° Caja y Dirección):" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="txtDescripcion" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,20" 
                         Background="#334155" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="10" FontSize="14"/>

                <TextBlock Text="Estado:" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <ComboBox x:Name="cboEstado" Height="40" Margin="0,0,0,30" Background="#334155" Foreground="Black" FontSize="14">
                    <ComboBoxItem Content="Activa" IsSelected="True"/>
                    <ComboBoxItem Content="Inactiva"/>
                </ComboBox>

                <Button x:Name="btnGuardar" Content="Guardar Caja" Height="42" Background="#F59E0B" 
                        Foreground="#0F172A" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>